# Source-distribution contents.
#
# ── Read this before editing ─────────────────────────────────────────────────────────
# hatchling does NOT read this file. It is a setuptools convention, and the authority
# for what actually ships is `[tool.hatch.build.targets.sdist]` and
# `[tool.hatch.build.targets.wheel]` in pyproject.toml. This file is kept because
# downstream tooling still looks for it — distribution packaging helpers, `check-manifest`,
# and several source-auditing tools — and because it is the first place a contributor
# used to setuptools will look. **Change pyproject.toml as well, or nothing happens.**
# ─────────────────────────────────────────────────────────────────────────────────────
#
# Why the sdist carries the tests: distribution packagers (Debian, Fedora, conda-forge)
# build from the sdist and run the suite from it. A package whose tests cannot be run
# downstream gets shipped untested, or not shipped at all.

include LICENSE
include README.md
include CHANGELOG.md
include CONTRIBUTING.md
include CODE_OF_CONDUCT.md
include SECURITY.md
include pyproject.toml
include tox.ini

# The package itself. `vantage` is mostly not Python: these templates and static files
# are located by path at runtime rather than imported, so a build that drops them
# produces a wheel that imports fine and 500s on the first page view.
recursive-include src/vantage *.py
recursive-include src/vantage/templates *.html
recursive-include src/vantage/static *.css *.js *.svg

# The suite, its fixture app, and the settings module it needs to run.
recursive-include tests *.py
include tests/settings.py

# Design records. Small, plain text, and the reason several decisions are the way
# they are.
recursive-include docs *.md

# Packaging checks that are meant to be runnable from the sdist.
include scripts/verify_wheel.py

# The demo project is deliberately absent: it carries a seeded SQLite database and is of
# no use to anyone installing from source. Read it in the repository.
prune example

global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .DS_Store
global-exclude *.sqlite3
